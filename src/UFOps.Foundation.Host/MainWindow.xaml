<Window
    x:Class="UFOps.Foundation.Host.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UFOps Foundation">
    <ScrollViewer>
        <Grid x:Name="RootGrid" Padding="32" Loaded="OnRootLoaded">
            <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="UFOps Foundation" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Live foundation health and storage qualification" Opacity="0.72" />
                <InfoBar x:Name="HealthInfo" IsOpen="True" Severity="Informational" Title="Checking foundation health..." />
                <Grid ColumnSpacing="16" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Database" FontWeight="SemiBold" />
                    <TextBlock x:Name="DatabasePathText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Schema" FontWeight="SemiBold" />
                    <TextBlock x:Name="SchemaVersionText" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SQLite quick_check" FontWeight="SemiBold" />
                    <TextBlock x:Name="QuickCheckText" Grid.Row="2" Grid.Column="1" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Windows App SDK" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="2.4.0 (self-contained)" />
                </Grid>
                <Button x:Name="RefreshButton" Content="Refresh health" Click="OnRefreshClicked" HorizontalAlignment="Left" />
                <TextBlock Text="This Foundation host does not implement file discovery, query, mutation, or document-processing product engines." TextWrapping="Wrap" Opacity="0.65" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
